<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<h1>Customers</h1>
<p class="sub">All customer accounts and order history totals. New signups show up here automatically.</p>

<form class="search" method="GET" action="/admin/customers">
  <input name="q" value="<%= search %>" placeholder="Search name or email" />
  <button class="primary" type="submit">Search</button>
</form>

<div class="table-wrap">
  <% if (!customers.length) { %>
    <p class="muted">No customers found.</p>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Joined</th>
          <th>Orders</th>
          <th>Spent</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% customers.forEach((customer) => { %>
          <tr>
            <td><%= customer.name %></td>
            <td><%= customer.email %></td>
            <td><%= formatDate(customer.createdAt) %></td>
            <td><%= customer.orderCount %></td>
            <td>$<%= customer.totalSpent %></td>
            <td><a href="/admin/customers/<%= customer._id %>">History →</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>
</div>
</body>
</html>
