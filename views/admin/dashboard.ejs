<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<h1>Dashboard</h1>
<p class="sub">Live snapshot of stored and upcoming marketplace data.</p>

<div class="grid">
  <a href="/admin/customers" class="card" style="display:block; text-decoration:none;"><div class="stat-label">Customers</div><div class="stat-value"><%= stats.customerCount %></div></a>
  <a href="/admin/vendors" class="card" style="display:block; text-decoration:none;"><div class="stat-label">Vendors</div><div class="stat-value"><%= stats.vendorCount %></div></a>
  <a href="/admin/products" class="card" style="display:block; text-decoration:none;"><div class="stat-label">Products</div><div class="stat-value"><%= stats.productCount %></div></a>
  <a href="/admin/orders" class="card" style="display:block; text-decoration:none;"><div class="stat-label">Orders</div><div class="stat-value"><%= stats.orderCount %></div></a>
  <div class="card"><div class="stat-label">Revenue</div><div class="stat-value">$<%= stats.revenue %></div></div>
</div>

<div class="section table-wrap">
  <h2>Recent orders</h2>
  <% if (!recentOrders.length) { %>
    <p class="muted">No orders yet. New checkouts will appear here automatically.</p>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Customer</th>
          <th>Total</th>
          <th>Paid</th>
        </tr>
      </thead>
      <tbody>
        <% recentOrders.forEach((order) => { %>
          <tr>
            <td><%= formatDate(order.createdAt) %></td>
            <td><%= order.customer?.name || 'Unknown' %><br /><span class="muted"><%= order.customer?.email || '' %></span></td>
            <td>$<%= formatMoney(order.totalPrice) %></td>
            <td><span class="badge <%= order.isPaid ? 'ok' : 'warn' %>"><%= order.isPaid ? 'Paid' : 'Unpaid' %></span></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>
</div>
</body>
</html>
